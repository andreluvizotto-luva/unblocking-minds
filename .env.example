# Chave da API da Anthropic (Claude) — nunca exponha no frontend, só é lida pelas rotas /api do servidor
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — projeto criado em https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave 'service_role' do Supabase (Project Settings -> API) — só usada nas rotas /api/admin/*
# NUNCA prefixar com NEXT_PUBLIC_ nem expor no navegador
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Chave da OpenAI — usada nas rotas /api/tts/generate (voz do listening) e
# /api/speaking/transcribe (transcrição da fala). Crie em platform.openai.com/api-keys
# NUNCA prefixar com NEXT_PUBLIC_ nem expor no navegador
OPENAI_API_KEY=sk-...

# Opcional — não usado mais (mantido apenas por compatibilidade com configurações antigas)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
