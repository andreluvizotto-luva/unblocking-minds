# Chave da API da Anthropic (Claude) — nunca exponha no frontend, só é lida pelas rotas /api do servidor
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — projeto criado em https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave 'service_role' do Supabase (Project Settings -> API) — só usada nas rotas /api/admin/*
# NUNCA prefixar com NEXT_PUBLIC_ nem expor no navegador
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Chave da OpenAI — usada nas rotas /api/tts/generate (voz do listening) e
# /api/speaking/transcribe (transcrição da fala). Crie em platform.openai.com/api-keys
# NUNCA prefixar com NEXT_PUBLIC_ nem expor no navegador
OPENAI_API_KEY=sk-...

# Opcional — não usado mais (mantido apenas por compatibilidade com configurações antigas)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Billing InfinitePay (assinatura mensal). Sua InfiniteTag, sem o "$" — e ative o
# "Checkout externo" nas configurações da conta InfinitePay antes de usar.
INFINITEPAY_HANDLE=
# Preço do plano mensal em centavos (7700 = R$ 77,00)
BILLING_MONTHLY_PRICE_CENTS=7700
# String aleatória longa — valida que o webhook veio de um link criado por nós
BILLING_WEBHOOK_SECRET=
# URL pública do app (usada no retorno do pagamento, no webhook e nos e-mails)
NEXT_PUBLIC_SITE_URL=https://maisunblocking.com.br

# E-mails de cobrança via Resend (resend.com). O domínio do remetente precisa
# estar verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM=+Unblocking <assinatura@maisunblocking.com.br>
# Segredo do Vercel Cron (a Vercel envia como "Authorization: Bearer ...")
CRON_SECRET=
